@model InventoryManagementSystem.Models.Supplier
@{
    ViewData["Title"] = "Edit Supplier";
    ViewData["Eyebrow"] = "Suppliers & Purchases · Edit";
}

<div class="panel" style="max-width:640px;">
    <div class="panel-header"><h2>Supplier Details</h2></div>
    <div class="panel-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="SupplierID" />
            <div asp-validation-summary="ModelOnly"></div>

            <div class="field-group">
                <label asp-for="SupplierName"></label>
                <input asp-for="SupplierName" class="form-control" />
                <span asp-validation-for="SupplierName" class="text-danger"></span>
            </div>

            <div class="field-group">
                <label asp-for="ContactName"></label>
                <input asp-for="ContactName" class="form-control" />
                <span asp-validation-for="ContactName" class="text-danger"></span>
            </div>

            <div class="field-group">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="field-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="field-group">
                <label asp-for="Address"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Save Changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}