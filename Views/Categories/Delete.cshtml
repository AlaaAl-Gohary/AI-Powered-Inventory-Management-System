@model InventoryManagementSystem.Models.Category

@{
    ViewData["Title"] = "Delete Category";
    ViewData["Eyebrow"] = "Products & Categories";
}

<div class="panel">
    <div class="panel-header">
        <h2>Delete Category</h2>
    </div>

    <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation"></i>
        Are you sure you want to delete this category?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Category Name</dt>
        <dd class="col-sm-9">@Model.CategoryName</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.Description)
                ? "No description"
                : Model.Description)
        </dd>

        <dt class="col-sm-3">Products</dt>
        <dd class="col-sm-9">@Model.Products.Count</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="CategoryID" />

        <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-trash"></i> Delete Category
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Cancel
        </a>
    </form>
</div>
