@model InventoryManagementSystem.Models.Category

@{
    ViewData["Title"] = "Category Details";
    ViewData["Eyebrow"] = "Products & Categories";
}

<div class="panel">
    <div class="panel-header">
        <h2>Category Details</h2>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Category Name</dt>
        <dd class="col-sm-9">@Model.CategoryName</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.Description)
                ? "No description"
                : Model.Description)
        </dd>

        <dt class="col-sm-3">Products</dt>
        <dd class="col-sm-9">@Model.Products.Count</dd>
    </dl>

    <div class="mt-4">
        <a asp-action="Edit"
           asp-route-id="@Model.CategoryID"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Products"
           asp-route-id="@Model.CategoryID"
           class="btn btn-secondary">
            Products
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back
        </a>
    </div>
</div>