@model InventoryManagementSystem.Models.Product

@{
    ViewData["Title"] = "Product Details";
    ViewData["Eyebrow"] = "Products & Categories";
}

<div class="panel">
    <div class="panel-header">
        <h2>Product Details</h2>
    </div>

    <dl class="row">
        <dt class="col-sm-3">SKU</dt>
        <dd class="col-sm-9">@Model.SKU</dd>

        <dt class="col-sm-3">Product Name</dt>
        <dd class="col-sm-9">@Model.ProductName</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category?.CategoryName</dd>

        <dt class="col-sm-3">Unit Price</dt>
        <dd class="col-sm-9">@Model.UnitPrice</dd>

        <dt class="col-sm-3">Stock Quantity</dt>
        <dd class="col-sm-9">@Model.StockQuantity</dd>

        <dt class="col-sm-3">Low Stock Threshold</dt>
        <dd class="col-sm-9">@Model.LowStockThreshold</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @if (Model.StockQuantity == 0)
            {
                <span class="badge bg-danger">Out of Stock</span>
            }
            else if (Model.StockQuantity <= Model.LowStockThreshold)
            {
                <span class="badge bg-warning text-dark">Low Stock</span>
            }
            else
            {
                <span class="badge bg-success">In Stock</span>
            }
        </dd>
    </dl>

    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.ProductID" class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back
        </a>
    </div>
</div>