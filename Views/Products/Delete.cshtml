@model InventoryManagementSystem.Models.Product

@{
    ViewData["Title"] = "Delete Product";
    ViewData["Eyebrow"] = "Products & Categories";
}

<div class="panel">
    <div class="panel-header">
        <h2>Delete Product</h2>
    </div>

    <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation"></i>
        Are you sure you want to delete this product?
    </div>

    <dl class="row">
        <dt class="col-sm-3">SKU</dt>
        <dd class="col-sm-9">@Model.SKU</dd>

        <dt class="col-sm-3">Product Name</dt>
        <dd class="col-sm-9">@Model.ProductName</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category?.CategoryName</dd>

        <dt class="col-sm-3">Unit Price</dt>
        <dd class="col-sm-9">@Model.UnitPrice</dd>

        <dt class="col-sm-3">Stock Quantity</dt>
        <dd class="col-sm-9">@Model.StockQuantity</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="ProductID" />

        <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-trash"></i> Delete Product
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Cancel
        </a>
    </form>
</div>