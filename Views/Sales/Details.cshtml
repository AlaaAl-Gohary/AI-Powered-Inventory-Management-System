@model InventoryManagementSystem.Models.Sale

@{
    ViewData["Title"] = " Sale Invoice";
}

<h2>Sale Invoice #@Model.SaleID</h2>
<p><strong>Date:</strong> @Model.SaleDate.ToString("yyyy-MM-dd HH:mm")</p>
<p><strong>Customer:</strong> @Model.CustomerInfo</p>

<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price </th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.SaleItems)
        {
            <tr>
                <td>@item.Product?.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("0.00")</td>
                <td>@((item.Quantity * item.UnitPrice).ToString("0.00"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Grand Total</th>
            <th>@Model.TotalAmount.ToString("0.00")</th>
        </tr>
    </tfoot>
</table>

<a asp-action="Index" class="btn btn-secondary">Back to Sales History</a>
<button onclick="window.print()" class="btn btn-primary">Print Invoice</button>
