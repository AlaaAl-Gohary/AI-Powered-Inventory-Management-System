@model InventoryManagementSystem.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["Eyebrow"] = "System";
}

<div class="panel">
    <div class="empty-state">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <div class="empty-title">Something went wrong</div>
        <p>An unexpected error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p class="num" style="color:var(--color-text-faint); font-size:12.5px;">Request ID: @Model.RequestId</p>
        }

        <a asp-controller="Suppliers" asp-action="Index" class="btn btn-primary"><i class="fa-solid fa-arrow-left"></i> Back to Suppliers</a>
    </div>
</div>