@model InventoryManagementSystem.Models.Sale

@{
    ViewData["Title"] = "فاتورة البيع";
}

<h2>فاتورة بيع رقم #@Model.SaleID</h2>
<p><strong>التاريخ:</strong> @Model.SaleDate.ToString("yyyy-MM-dd HH:mm")</p>
<p><strong>العميل:</strong> @Model.CustomerInfo</p>

<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>المنتج</th>
            <th>الكمية</th>
            <th>سعر الوحدة</th>
            <th>الإجمالي</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.SaleItems)
        {
            <tr>
                <td>@item.Product?.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("0.00")</td>
                <td>@((item.Quantity * item.UnitPrice).ToString("0.00"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">الإجمالي الكلي</th>
            <th>@Model.TotalAmount.ToString("0.00")</th>
        </tr>
    </tfoot>
</table>

<a asp-action="Index" class="btn btn-secondary">رجوع لسجل المبيعات</a>
<button onclick="window.print()" class="btn btn-primary">طباعة الفاتورة</button>
